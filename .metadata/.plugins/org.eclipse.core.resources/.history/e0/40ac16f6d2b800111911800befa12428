/*Escribir un programa que solicite las notas del primer,
 * segundo y tercer trimestre
 * (notas enteras que se solicitarán al usuario).
 * El programa debe mostrar la nota media del curso como se
 * utiliza en el boletín de calificaciones (solo la parte entera)
 * y como se usa en el expediente académico (con decimales).
 */
package ejercicios.parte1;

import java.util.Scanner;

public class Ejercicio14 {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		System.out.print("Notas del primer trimestre: ");
		Integer notasPrimerTrimestre = sc.nextInt();
		System.out.print("\nNotas del segundo trimestre: ");
		Integer notasSegundoTrimestre = sc.nextInt();		
		System.out.print("\nNotas del tercer trimestre: ");
		Integer notasTercerTrimestre = sc.nextInt();		
		
		Integer sumaTrimestre = notasPrimerTrimestre + notasSegundoTrimestre + notasTercerTrimestre;
		System.out.print("\nNotas boletín de calificaciones: "+ sumaTrimestre/3);
		System.out.print("\nNotas boletín de calificaciones: "+ (double)sumaTrimestre/3);

		
		sc.close();
	}
}

/*Modifica el ejercicio anterior para que, indicando dos números,
 * por ejemplo, num1 y num2, diga qué cantidad hay que sumarle a
 * num1 para que sea múltiplo de num2.
 */
package ejercicios.parte2;

import java.util.Scanner;

public class Ejercicio03 {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		System.out.print("Indica un número entero: ");
		Integer numeroOriginal = sc.nextInt();
		System.out.print("\n");
		Integer numero = numeroOriginal;
		
		while (numero%7!=0) {
			numero++;
		}
		System.out.println("\nAl numero "+numeroOriginal+" habría que sumarle "+(numero-numeroOriginal)+" para que sea múltiplo de 7.");
		sc.close();
	}

}
/*Realizar una aplicación que solicite al usuario su edad
 * y le indique si es mayor de edad
 * (mediante un literal booleano: true o false).
 */
package ejercicios.parte1;

import java.util.Scanner;

public class Ejercicio9 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		System.out.print("¿Eres mayor de edad? ");
		
		Integer edad = sc.nextInt();
		
		
		Boolean mayorEdad;
		
		if(mayorEdad==true) {
			System.out.println("\nEres mayor de edad");
		}else {
			System.out.print("\nEres menor de edad");
		}
		System.out.println("");
		
	}
}

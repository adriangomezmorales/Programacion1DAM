/*Realizar una aplicación que solicite al usuario su edad
 * y le indique si es mayor de edad
 * (mediante un literal booleano: true o false).
 */
package ejercicios.parte1;

import java.util.Scanner;

public class Ejercicio9 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		System.out.print("¿Cuál es tu edad? ");
		
		Integer edad = sc.nextInt();
		

		Boolean mayorEdad = (edad>18) ? true:false;
		
		
		if(mayorEdad==true) {
			System.out.print("\nEres mayor de edad");
		}else {
			System.out.print("\nEres menor de edad");
		}
		System.out.println(". Porque tienes "+edad+" años");
		
	}
}
